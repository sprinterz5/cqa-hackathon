# Organizers' dataset endpoint WITHOUT the group_id parameter (contains a signature, never commit)
DATA_API_URL=https://...powerplatform.com/.../invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=...

# Primary LLM (OpenAI-compatible), e.g. Alem Plus
LLM_BASE_URL=https://.../v1
LLM_API_KEY=
LLM_MODEL=gpt-oss
LLM_MAX_PARALLEL=2
# Fallback LLM, e.g. DeepSeek (prices in USD per 1M tokens, for cost reporting)
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_API_KEY=
FALLBACK_MODEL=deepseek-chat
FALLBACK_PRICE_IN=
FALLBACK_PRICE_OUT=
# Optional local model via Ollama
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3:8b
# Alem Speech-to-text (general / Kazakh / English)
STT_API_KEY=
STT_KZ_API_KEY=
STT_BASE_URL=https://llm.alem.ai/v1
STT_MODEL=speech-to-text
STT_KZ_MODEL=speech-to-text-kk
